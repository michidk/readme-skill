{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "profile": {
      "default": "application",
      "type": "string",
      "enum": [
        "application",
        "library",
        "cli",
        "experimental",
        "infrastructure",
        "resource"
      ]
    },
    "maturity": {
      "type": "string",
      "enum": [
        "experimental",
        "active",
        "maintenance",
        "archived"
      ]
    },
    "presentation": {
      "type": "string",
      "enum": [
        "serious",
        "neutral",
        "fancy"
      ]
    },
    "maxBadges": {
      "default": 4,
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "imageBudgetBytes": {
      "default": 500000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "heroBudgetBytes": {
      "default": 300000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "requiredSections": {
      "default": [
        "usage",
        "contributing",
        "license"
      ],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 350
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "topics": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"
      }
    },
    "related": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[\\w.-]+\\/[\\w.-]+$"
          },
          "relationship": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "repository",
          "relationship",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "maxBadges",
    "imageBudgetBytes",
    "heroBudgetBytes",
    "requiredSections",
    "related"
  ],
  "additionalProperties": false
}
