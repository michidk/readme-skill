{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "badge"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "face": {
          "default": "light",
          "type": "string",
          "const": "light"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "label",
        "value",
        "face"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "kind": {
          "type": "string",
          "const": "diagram"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "orientation": {
          "default": "vertical",
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "nodes": {
          "minItems": 2,
          "maxItems": 7,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "desc": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "target": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            },
            "required": [
              "source",
              "target"
            ],
            "additionalProperties": false
          }
        },
        "face": {
          "default": "light",
          "type": "string",
          "const": "light"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "title",
        "orientation",
        "nodes",
        "edges",
        "face"
      ],
      "additionalProperties": false
    }
  ]
}
